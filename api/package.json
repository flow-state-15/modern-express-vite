{
  "name": "modern-express-api",
  "version": "1.0.0",
  "description": "A modern Express API with a Vite frontend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "tsc -b && node dist/src/app.js",
    "dev": "tsc -b && nodemon --exec node dist/index.js",
    "build": "tsc -b",
    "test": "npm run build && NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --config jest.config.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.9",
    "@types/supertest": "^2.0.16",
    "jest": "^30.1.3",
    "prisma": "^6.19.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
